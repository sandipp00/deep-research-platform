# Server
HOST=0.0.0.0
PORT=8004

# Redis
REDIS_URL=redis://localhost:6379

# LLM — OpenRouter primary (REQUIRED)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TEMPERATURE=0.3

# LLM — OpenAI fallback (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Web Search — Octen primary (REQUIRED)
OCTEN_API_KEY=octen-...
OCTEN_MAX_RESULTS=5

# Web Search — Tavily fallback (recommended)
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=advanced

# Jina Reader (optional — free tier works without key)
JINA_API_KEY=

# No keys needed for:
# Wikipedia, OSM Overpass, Nominatim, yfinance,
# Frankfurter, CoinGecko, RSS feeds, PyMuPDF, DuckDuckGo
